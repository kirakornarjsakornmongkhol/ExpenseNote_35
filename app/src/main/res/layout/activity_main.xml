<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- การ์ดหลัก -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:orientation="vertical">

            <!-- หัวข้อแอป -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="บันทึกค่าใช้จ่ายประจำวัน"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="จดทุกบาทที่ใช้ไว้นี้ให้ครบเลยนะ"
                android:textSize="14sp"
                android:textColor="#777777"
                android:layout_marginBottom="16dp"
                android:layout_gravity="center_horizontal" />

            <!-- ช่องกรอกจำนวนเงิน -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="โปรดใส่จำนวนเงิน (เป็นบาท)"
                android:textColor="#555555"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#FCC6BB"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="numberDecimal"
                android:hint="เช่น 100 หรือ 10.25"
                android:textColor="#333333"
                android:textColorHint="#AAAAAA"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <!-- ช่องคำอธิบาย -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="คำอธิบาย"
                android:textColor="#555555"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#FCC6BB"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="text"
                android:hint="เช่น ข้าวกลางวัน, ค่าเดินทาง"
                android:textColor="#333333"
                android:textColorHint="#AAAAAA"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <!-- ปุ่มต่าง ๆ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="เคลียร์"
                    android:textAllCaps="false"
                    android:backgroundTint="#FFE0E0"
                    android:textColor="#C34C4C"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="เพิ่มรายการ"
                    android:textAllCaps="false"
                    android:backgroundTint="#FFB6C1"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

            <!-- เส้นคั่นเล็ก ๆ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FFE3E3"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp" />

            <!-- แสดงผล -->
            <TextView
                android:id="@+id/tvLastItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="รายการล่าสุด: -"
                android:textColor="#555555"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ยอดรวมวันนี้: 0.00 บาท"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
